# Copy to .env and adjust. Never commit .env.
# The API reads SALESIQ_* variables; see apps/api/app/core/config.py for all options.

SALESIQ_ENVIRONMENT=development
SALESIQ_LOG_LEVEL=INFO
SALESIQ_LOG_JSON=true

# Host ports for docker compose (defaults avoid clashing with other local Postgres/Redis)
SALESIQ_PG_PORT=55432
SALESIQ_REDIS_PORT=56379

# Runtime role: never a superuser or table owner, or row-level security is bypassed.
SALESIQ_DATABASE_URL=postgresql+psycopg://salesiq_app:salesiq_app@127.0.0.1:55432/salesiq
# Schema owner, used only by Alembic migrations.
SALESIQ_MIGRATION_DATABASE_URL=postgresql+psycopg://salesiq:salesiq@127.0.0.1:55432/salesiq
SALESIQ_REDIS_URL=redis://127.0.0.1:56379/0

# Required (>= 32 chars) outside development. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SALESIQ_SECRET_KEY=

SALESIQ_CORS_ORIGINS=["http://localhost:3000"]
SALESIQ_WEB_BASE_URL=http://localhost:3000

# Auth
SALESIQ_REGISTRATION_ENABLED=true
# log = print emails (with action links) to the API log; development only.
SALESIQ_MAILER=log

# Web (server-side only; never prefix with NEXT_PUBLIC_)
SALESIQ_API_URL=http://127.0.0.1:8000

# Real models only; see apps/api/app/agents/llm/models.yaml.
# Local Ollama, used by default:
# SALESIQ_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Hosted Hugging Face router (optional, may bill the token owner):
HF_TOKEN=
