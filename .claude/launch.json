{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "salesiq-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "apps/api", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--reload", "--reload-dir", "apps/api/app", "--host", "127.0.0.1", "--port", "8017"],
      "port": 8017
    },
    {
      "name": "salesiq-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@salesiq/web", "exec", "next", "dev", "--port", "3100"],
      "env": { "SALESIQ_API_URL": "http://127.0.0.1:8017" },
      "port": 3100
    }
  ]
}
